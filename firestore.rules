rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || !('uid' in resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidEmail(email) {
      return email is string && email.matches("^[^@]+@[^@]+\\.[^@]+$");
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "bmyanmar61@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'language', 'isPremium', 'premiumStatus', 'createdAt', 'lastLogin', 'bio', 'paymentDetails', 'shopLocation', 'homeLocation', 'phone']) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() >= 0 && data.displayName.size() < 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && isValidEmail(data.email))) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() < 2000)) &&
             data.role in ['buyer', 'seller'] &&
             (!('language' in data) || (data.language is string && data.language in ['en', 'my', 'lo', 'th', 'zh'])) &&
             (!('isPremium' in data) || data.isPremium is bool) &&
             (!('premiumStatus' in data) || data.premiumStatus in ['none', 'pending', 'approved', 'rejected']) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('lastLogin' in data) || data.lastLogin is string) &&
             (!('bio' in data) || data.bio is string && data.bio.size() < 1000) &&
             (!('phone' in data) || data.phone is string && data.phone.size() < 20) &&
             (!('paymentDetails' in data) || data.paymentDetails is string && data.paymentDetails.size() < 1000) &&
             (!('shopLocation' in data) || data.shopLocation == null || (data.shopLocation is map && data.shopLocation.keys().hasOnly(['latitude', 'longitude']) && data.shopLocation.latitude is number && data.shopLocation.longitude is number)) &&
             (!('homeLocation' in data) || data.homeLocation == null || (data.homeLocation is map && data.homeLocation.keys().hasOnly(['latitude', 'longitude']) && data.homeLocation.latitude is number && data.homeLocation.longitude is number));
    }

    function isValidProduct(data) {
      return data.keys().hasOnly(['title', 'description', 'price', 'discountPrice', 'currency', 'category', 'image', 'images', 'video', 'sellerId', 'sellerName', 'sellerPhoto', 'sellerLocation', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             (!('description' in data) || (data.description is string && data.description.size() < 2000)) &&
             data.price is number && data.price >= 0 &&
             (!('discountPrice' in data) || data.discountPrice == null || (data.discountPrice is number && data.discountPrice >= 0 && data.discountPrice < data.price)) &&
             data.currency in ['MMK', 'THB', 'USD', 'LAK', 'CNY'] &&
             (!('category' in data) || (data.category is string && data.category.size() < 100)) &&
             data.image is string && data.image.size() < 2000000 &&
             (!('images' in data) || (data.images is list && data.images.size() <= 5)) &&
             (!('video' in data) || data.video == null || (data.video is string && data.video.size() < 2000)) &&
             data.sellerId is string && data.sellerId == request.auth.uid &&
             data.sellerName is string && data.sellerName.size() < 100 &&
             (!('sellerPhoto' in data) || data.sellerPhoto == null || (data.sellerPhoto is string && data.sellerPhoto.size() < 2000)) &&
             (!('sellerLocation' in data) || data.sellerLocation == null || data.sellerLocation is map) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidChat(data) {
      return data.keys().hasOnly(['buyerId', 'sellerId', 'deliveryId', 'participants', 'productId', 'productTitle', 'productImage', 'lastMessage', 'lastMessageTime', 'createdAt', 'buyerTyping', 'sellerTyping']) &&
             data.buyerId is string && data.buyerId.size() > 0 && data.buyerId.size() < 100 &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() < 100 &&
             (!('deliveryId' in data) || data.deliveryId == null || (data.deliveryId is string && data.deliveryId.size() < 100)) &&
             data.participants is list && data.participants.size() >= 2 && data.participants.size() <= 3 &&
             data.productId is string && data.productId.size() > 0 && data.productId.size() < 100 &&
             (!('productTitle' in data) || (data.productTitle is string && data.productTitle.size() < 200)) &&
             (!('productImage' in data) || (data.productImage is string && data.productImage.size() < 2000)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() < 2000)) &&
             (!('lastMessageTime' in data) || data.lastMessageTime is number) &&
             (!('createdAt' in data) || data.createdAt is number) &&
             (!('buyerTyping' in data) || data.buyerTyping is bool) &&
             (!('sellerTyping' in data) || data.sellerTyping is bool);
    }

    function isValidMessage(data) {
      return data.keys().hasOnly(['senderId', 'text', 'originalLang', 'translations', 'timestamp', 'isLocation', 'isRead', 'imageUrl']) &&
             data.senderId is string && data.senderId == request.auth.uid &&
             (!('text' in data) || (data.text is string && data.text.size() < 2000)) &&
             (!('originalLang' in data) || (data.originalLang is string && data.originalLang.size() < 10)) &&
             (!('translations' in data) || data.translations is map) &&
             data.timestamp is number &&
             (!('isLocation' in data) || data.isLocation is bool) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 2000000));
    }

    function isValidAddress(data) {
      return data.keys().hasOnly(['userId', 'fullName', 'phone', 'addressLine', 'city', 'latitude', 'longitude', 'isDefault', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.fullName is string && data.fullName.size() > 0 && data.fullName.size() < 100 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() < 20 &&
             data.addressLine is string && data.addressLine.size() > 0 && data.addressLine.size() < 500 &&
             data.city is string && data.city.size() > 0 && data.city.size() < 100 &&
             (!('latitude' in data) || data.latitude == null || data.latitude is number) &&
             (!('longitude' in data) || data.longitude == null || data.longitude is number) &&
             (!('isDefault' in data) || data.isDefault is bool) &&
             (!('createdAt' in data) || data.createdAt is string);
    }

    function isValidOrder(data) {
      return data.keys().hasOnly(['userId', 'sellerIds', 'items', 'total', 'currency', 'status', 'address', 'sellerLocation', 'createdAt']) &&
             (data.userId == request.auth.uid || (resource != null && resource.data.userId == request.auth.uid)) &&
             (!('sellerIds' in data) || data.sellerIds is list) &&
             data.items is list &&
             data.total is number &&
             data.currency is string &&
             data.status in ['pending', 'processing', 'shipped', 'delivering', 'delivered', 'cancelled'] &&
             data.address is map &&
             (!('sellerLocation' in data) || (data.sellerLocation is map && data.sellerLocation.keys().hasAll(['latitude', 'longitude', 'updatedAt']))) &&
             data.createdAt is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged() && 
                    (!('isPremium' in request.resource.data) || request.resource.data.isPremium == false) &&
                    (!('premiumStatus' in request.resource.data) || request.resource.data.premiumStatus == 'none');
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && uidNotModified() && 
                    (
                      (isOwner(userId) && 
                       request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false) && 
                       (request.resource.data.get('premiumStatus', 'none') == resource.data.get('premiumStatus', 'none') || request.resource.data.premiumStatus == 'pending')
                      ) || 
                      isAdmin()
                    );
      // Allow admins to query users
      allow list: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidProduct(request.resource.data);
      allow update: if isAuthenticated() && resource.data.sellerId == request.auth.uid && isValidProduct(request.resource.data) && 
                    (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAuthenticated() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow list: if isAuthenticated() && (request.query.limit <= 100); // Basic list allowed, filtered by participants in code
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants) && isValidChat(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants) && isValidChat(request.resource.data) && 
                    (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) && 
                    (!('buyerId' in resource.data) || !('buyerId' in request.resource.data) || request.resource.data.buyerId == resource.data.buyerId) && 
                    (!('sellerId' in resource.data) || !('sellerId' in request.resource.data) || request.resource.data.sellerId == resource.data.sellerId);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) && isValidMessage(request.resource.data);
        allow update: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) && isValidMessage(request.resource.data) && 
                      request.resource.data.senderId == resource.data.senderId && 
                      request.resource.data.timestamp == resource.data.timestamp;
      }
    }
    match /directChats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants);
        allow create: if isAuthenticated() && (request.auth.uid in get(/databases/$(database)/documents/directChats/$(chatId)).data.participants);
      }
    }
    
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
    }
    
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
      );
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Favorites collection
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.keys().hasAll(['userId', 'productId', 'createdAt']) && request.resource.data.userId is string && request.resource.data.productId is string && request.resource.data.createdAt is number;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /addresses/{addressId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidAddress(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidAddress(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || (request.auth.uid in resource.data.sellerIds));
      allow create: if isAuthenticated() && isValidOrder(request.resource.data);
      allow update: if isAuthenticated() && (isAdmin() || (request.auth.uid in resource.data.sellerIds));
    }
  }
}
