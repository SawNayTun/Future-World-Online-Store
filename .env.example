# .env.example
# -----------------------------------------------------------------------------
# INSTRUCTIONS FOR BUYERS:
# 1. Copy this file and rename it to `.env`
# 2. Replace the placeholder values below with your actual API keys
# 3. NEVER commit your actual `.env` file to version control (GitHub, etc.)
# -----------------------------------------------------------------------------

# GEMINI_API_KEY: Required if you plan to integrate Gemini AI features into the template.
# You can get your free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this app is hosted (e.g., http://localhost:3000 for local development)
APP_URL="http://localhost:3000"
